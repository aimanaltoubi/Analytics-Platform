{
  "name": "RiskProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "risk_threshold",
        "watchlist",
        "hub",
        "co_occurrence",
        "cluster_size"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0642\u0627\u0639\u062f\u0629"
    },
    "conditions": {
      "type": "object",
      "title": "\u0627\u0644\u0634\u0631\u0648\u0637"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "\u062e\u0637\u0648\u0631\u0629 \u0627\u0644\u062a\u0646\u0628\u064a\u0647",
      "default": "medium"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "title": "\u0645\u0641\u0639\u0651\u0644"
    }
  },
  "required": [
    "name",
    "rule_type"
  ]
}