{
  "name": "Alert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0646\u0648\u0627\u0646"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "\u0627\u0644\u062e\u0637\u0648\u0631\u0629",
      "default": "medium"
    },
    "rule_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0642\u0627\u0639\u062f\u0629"
    },
    "rule_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0642\u0627\u0639\u062f\u0629"
    },
    "rule_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0642\u0627\u0639\u062f\u0629"
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "entity_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "acknowledged",
        "resolved"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "new"
    },
    "triggered_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u0648\u0642\u062a \u0627\u0644\u062a\u0641\u0639\u064a\u0644"
    },
    "details": {
      "type": "object",
      "title": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0625\u0636\u0627\u0641\u064a\u0629"
    }
  },
  "required": [
    "title",
    "severity"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}