{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "manifest_screening",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "screen": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "screenManifest",
            "args": {
              "manifest_id": "${ .trigger.entity_id }"
            }
          },
          "then": "ner",
          "x-base44": {
            "title": "\u0641\u062d\u0635 \u0627\u0644\u0628\u064a\u0627\u0646",
            "description": "\u0645\u0642\u0627\u0628\u0644\u0629 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629"
          }
        }
      },
      {
        "ner": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processManifest",
            "args": {
              "manifest_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a",
            "description": "\u062a\u062d\u0648\u064a\u0644 \u0628\u064a\u0627\u0646 \u0627\u0644\u0628\u064a\u0627\u0646 \u0625\u0644\u0649 \u0646\u0635 \u063a\u064a\u0631 \u0645\u0647\u064a\u0643\u0644 \u0648\u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0645\u0646\u0647"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Manifest"
    }
  },
  "description": "\u064a\u0641\u062d\u0635 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0631\u0643\u0627\u0628 \u0648\u0627\u0644\u0634\u062d\u0646 \u0641\u0648\u0631 \u062a\u0642\u062f\u064a\u0645\u0647\u0627 \u0645\u0642\u0627\u0628\u0644 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0648\u064a\u064f\u0635\u062f\u0631 \u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0645\u0646\u0639 \u0627\u0644\u0637\u064a\u0631\u0627\u0646\u060c \u062b\u0645 \u064a\u062d\u0648\u0651\u0644 \u0627\u0644\u0628\u064a\u0627\u0646 \u0625\u0644\u0649 \u0646\u0635 \u063a\u064a\u0631 \u0645\u0647\u064a\u0643\u0644 \u0648\u064a\u064f\u0634\u063a\u0651\u0644 \u0639\u0644\u064a\u0647 \u0645\u062d\u0631\u0643 \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a \u0644\u0628\u0646\u0627\u0621 \u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u0623\u0645\u0646 \u0627\u0644\u062d\u062f\u0648\u062f",
  "name": "Manifest Screening"
}