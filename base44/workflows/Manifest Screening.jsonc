{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "manifest_screening",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "screen": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "screenManifest",
            "args": {
              "manifest_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0641\u062d\u0635 \u0627\u0644\u0628\u064a\u0627\u0646",
            "description": "\u0645\u0642\u0627\u0628\u0644\u0629 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Manifest"
    }
  },
  "description": "\u064a\u0641\u062d\u0635 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0631\u0643\u0627\u0628 \u0648\u0627\u0644\u0634\u062d\u0646 \u0641\u0648\u0631 \u062a\u0642\u062f\u064a\u0645\u0647\u0627 \u0645\u0642\u0627\u0628\u0644 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0648\u064a\u064f\u0635\u062f\u0631 \u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0645\u0646\u0639 \u0627\u0644\u0637\u064a\u0631\u0627\u0646",
  "name": "Manifest Screening"
}