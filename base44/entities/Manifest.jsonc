{
  "name": "Manifest",
  "type": "object",
  "properties": {
    "manifest_type": {
      "type": "string",
      "enum": [
        "passenger",
        "cargo"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0628\u064a\u0627\u0646",
      "default": "passenger"
    },
    "mode": {
      "type": "string",
      "enum": [
        "air",
        "sea"
      ],
      "title": "\u0648\u0633\u064a\u0644\u0629 \u0627\u0644\u0646\u0642\u0644",
      "default": "air"
    },
    "carrier": {
      "type": "string",
      "title": "\u0627\u0644\u0646\u0627\u0642\u0644"
    },
    "voyage_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0631\u062d\u0644\u0629"
    },
    "departure_location": {
      "type": "string",
      "title": "\u0645\u0643\u0627\u0646 \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629"
    },
    "destination_location": {
      "type": "string",
      "title": "\u0645\u0643\u0627\u0646 \u0627\u0644\u0648\u0635\u0648\u0644"
    },
    "departure_datetime": {
      "type": "string",
      "format": "date-time",
      "title": "\u0648\u0642\u062a \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "screening",
        "cleared",
        "flagged",
        "intercepted"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "submitted"
    },
    "passengers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "passport_number": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          },
          "dob": {
            "type": "string"
          },
          "seat": {
            "type": "string"
          }
        }
      },
      "title": "\u0627\u0644\u0631\u0643\u0627\u0628"
    },
    "cargo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "weight": {
            "type": "string"
          },
          "consignee": {
            "type": "string"
          },
          "hazardous": {
            "type": "boolean"
          }
        }
      },
      "title": "\u0627\u0644\u0634\u062d\u0646\u0627\u062a"
    },
    "screening_summary": {
      "type": "object",
      "title": "\u0645\u0644\u062e\u0635 \u0627\u0644\u0641\u062d\u0635"
    },
    "submitted_by": {
      "type": "string",
      "title": "\u0645\u064f\u0642\u062f\u0651\u0645 \u0627\u0644\u0628\u064a\u0627\u0646"
    }
  },
  "required": [
    "manifest_type",
    "carrier",
    "voyage_number"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}