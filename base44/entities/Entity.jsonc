{
  "name": "Entity",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645"
    },
    "type": {
      "type": "string",
      "enum": [
        "person",
        "organization",
        "phone",
        "email",
        "location",
        "account",
        "date",
        "event",
        "other"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0643\u064a\u0627\u0646",
      "default": "person"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0628\u062f\u064a\u0644\u0629"
    },
    "attributes": {
      "type": "object",
      "title": "\u0633\u0645\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "photo_url": {
      "type": "string",
      "title": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0643\u064a\u0627\u0646"
    },
    "latitude": {
      "type": "number",
      "title": "\u062e\u0637 \u0627\u0644\u0639\u0631\u0636"
    },
    "longitude": {
      "type": "number",
      "title": "\u062e\u0637 \u0627\u0644\u0637\u0648\u0644"
    },
    "mention_count": {
      "type": "number",
      "default": 1,
      "title": "\u0639\u062f\u062f \u0627\u0644\u0630\u0643\u0631"
    },
    "risk_score": {
      "type": "number",
      "default": 0,
      "title": "\u062f\u0631\u062c\u0629 \u0627\u0644\u062e\u0637\u0648\u0631\u0629"
    },
    "watchlist": {
      "type": "boolean",
      "default": false,
      "title": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629"
    },
    "document_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}